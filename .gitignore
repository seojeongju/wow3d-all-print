# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# opennext (Cloudflare)
.open-next

# cloudflare
.wrangler
.dev.vars
wrangler.toml.backup
*.toml.backup

# typescript
*.tsbuildinfo
next-env.d.ts
_temp_migration/

# editor (local)
.vscode/

# 고객·학습용 샘플 (커밋 금지) — public 기본 데모 STL은 유지
/public/AMR_*
/public/**/*.step
/public/**/*.stp
!/public/test_cube.stl
!/public/broken_sample.stl
!/public/jet_engine_rotor.stl
/scripts/amr-multi-quote-report.json
/tmp-*.json

